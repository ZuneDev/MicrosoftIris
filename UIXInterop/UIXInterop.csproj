<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <AssemblyName>UIXInterop</AssemblyName>
        <RootNamespace>Microsoft.Iris.Interop</RootNamespace>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Not published directly: a plain library referenced by UIXrender/UIXsup
             (and future NativeAOT-published projects), which pull it into their own
             PublishAot output as an ordinary assembly reference. -->
    </PropertyGroup>
</Project>
